% relatorio.sty -- versao article/report do estilo de perrijuan/latex-presentation
% (presentation.sty, Beamer). Mantem fontes, cores, titulos em versalete minusculo,
% marcadores cinza, alertas e legendas do template; troca o tema Beamer por um
% documento corrido. Compilar com pdfLaTeX, como o template original.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{relatorio}[2026/10/19 Estilo de relatorio derivado de presentation.sty]

% ---- Pagina ----
\RequirePackage[a4paper, margin=25mm, top=22mm, bottom=25mm]{geometry}
\RequirePackage[dvipsnames]{xcolor}
\RequirePackage{amsmath}

% ---- Fontes de texto (iguais ao template) ----
\RequirePackage{sourcesanspro}
\renewcommand{\familydefault}{\sfdefault} % Beamer ja usa sans por padrao; no article e preciso declarar
\DeclareRobustCommand{\sbseries}{\fontseries{sb}\selectfont}
\DeclareTextFontCommand{\textsb}{\sbseries}
\RequirePackage{sourcecodepro}
\RequirePackage[T1]{fontenc}

% ---- Fontes matematicas (iguais ao template) ----
\RequirePackage{MnSymbol}
\RequirePackage[cal=euler, bb=fourier]{mathalpha}
\newcommand{\hmmax}{0}
\newcommand{\bmmax}{0}
\RequirePackage{bm}
\RequirePackage[italic, eulergreek, nolessnomore, noparenthesis, noplusnominus, noequal, nohbar]{mathastext}
\MTsetmathskips{y}{2mu}{0mu}
\MTsetmathskips{j}{2mu}{0mu}

% ---- Espacamento ----
\RequirePackage{setspace}
\setstretch{1.25}
\RequirePackage{microtype}
\DisableLigatures[f]{encoding = *, family = * }
\setlength{\parindent}{0pt}
\setlength{\parskip}{6pt}
\setlength{\emergencystretch}{3em}

% ---- Cores (iguais ao template) ----
\colorlet{BlackGray}{black!85!}
\colorlet{DarkGray}{gray!65!}
\colorlet{LightGray}{gray!30!}
\colorlet{PaleGray}{gray!12!}
\AtBeginDocument{\color{BlackGray}}

% ---- Titulos: versalete minusculo, como os frame titles ----
\RequirePackage[explicit]{titlesec}
\titleformat{\section}{\Large\scshape\color{BlackGray}}{\color{DarkGray}\thesection}{0.8em}{\MakeLowercase{#1}}[{\color{LightGray}\titlerule[0.8pt]}]
\titleformat{\subsection}{\large\scshape\color{BlackGray}}{\color{DarkGray}\thesubsection}{0.8em}{\MakeLowercase{#1}}
\titleformat{\subsubsection}{\normalsize\sbseries\color{BlackGray}}{}{0em}{#1}
\titlespacing*{\section}{0pt}{18pt}{8pt}
\RequirePackage{needspace}
\pretocmd{\section}{\Needspace{8\baselineskip}}{}{}
\titlespacing*{\subsection}{0pt}{12pt}{4pt}
\titlespacing*{\subsubsection}{0pt}{8pt}{2pt}

% ---- Pagina de titulo (mesmo desenho do title page do template) ----
\RequirePackage{etoolbox}
\newcommand*{\inserturl}{}
\newcommand*{\paperurl}[1]{\renewcommand*{\inserturl}{#1}}
\renewcommand{\maketitle}{%
\begingroup\singlespacing
{\huge\scshape\color{BlackGray}\MakeLowercase{\@title}\par}%
\vspace{2mm}{\color{BlackGray}\rule{\textwidth}{1.5pt}\par}%
\vspace{6mm}{\large\@author\par}%
\vspace{2mm}{\large\@date\par}%
\ifdefempty{\inserturl}{}{\vspace{2mm}{\color{DarkGray}\footnotesize Disponível em \url{\inserturl}\par}}%
\endgroup\vspace{8mm}}

% ---- Listas (marcadores do template, em cinza) ----
\RequirePackage{enumitem}
\setlist{itemsep=1pt, topsep=3pt, parsep=1pt}
\setlist[itemize,1]{label={\color{DarkGray}\textbullet}}
\setlist[itemize,2]{label={\color{DarkGray}\textendash}}
\setlist[enumerate,1]{label={\color{DarkGray}\arabic*.}}
\setlist[enumerate,2]{label={\color{DarkGray}\alph*.}}

% ---- Alertas (iguais ao template) ----
\newcommand{\al}[1]{\textcolor{RubineRed}{#1}}
\newcommand{\alg}[1]{\textcolor{Green}{#1}}
\newcommand{\alr}[1]{\textcolor{Red}{#1}}
\newcommand{\alb}[1]{\textcolor{NavyBlue}{#1}}

% ---- Tabelas e legendas ----
\RequirePackage{booktabs}
\RequirePackage{multirow}
\RequirePackage{tabularx}
\RequirePackage{array}
\RequirePackage{float}
\RequirePackage[font={footnotesize,color=DarkGray}, labelfont=sc, justification=centering, skip=5pt]{caption}

% ---- Blocos (equivalente ao block do Beamer, fundo LightGray) ----
\RequirePackage[most]{tcolorbox}
\newtcolorbox{bloco}[1][]{colback=PaleGray, colframe=PaleGray, coltext=BlackGray,
  boxrule=0pt, arc=1.5mm, left=3mm, right=3mm, top=2mm, bottom=2mm,
  fonttitle=\sbseries, coltitle=BlackGray, colbacktitle=LightGray,
  title={#1}, before skip=6pt, after skip=6pt}

% ---- Codigo ----
\RequirePackage{listings}
\lstset{basicstyle=\ttfamily\small\color{BlackGray}, backgroundcolor=\color{PaleGray},
  frame=single, rulecolor=\color{PaleGray}, framesep=2mm, xleftmargin=2mm, xrightmargin=2mm,
  columns=fullflexible, keepspaces=true, breaklines=true, showstringspaces=false,
  commentstyle=\color{DarkGray}, keywordstyle=\sbseries, aboveskip=6pt, belowskip=6pt}
\newcommand{\codus}{\textunderscore\allowbreak}
\newcommand{\cod}[1]{{\ttfamily\let\_\codus #1}}

% ---- Diagramas ----
\RequirePackage{tikz}
\usetikzlibrary{arrows.meta, positioning, fit, calc}
\tikzset{caixa/.style={fill=PaleGray, draw=LightGray, rounded corners=1.5mm, align=center,
    inner sep=2mm, font=\small, text=BlackGray},
  seta/.style={-{Stealth[length=2mm]}, DarkGray, thick}}

% ---- Cabecalho e rodape ----
\RequirePackage{fancyhdr}
\pagestyle{fancy}\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\fancyfoot[R]{\footnotesize\color{DarkGray}\thepage}
\fancyfoot[L]{\footnotesize\color{DarkGray}\scshape\MakeLowercase{\@title}}
\fancypagestyle{plain}{\fancyhf{}\fancyfoot[R]{\footnotesize\color{DarkGray}\thepage}}

% ---- Links ----
\RequirePackage{hyperref}
\hypersetup{hidelinks, pdfdisplaydoctitle=true, pdfpagemode=UseOutlines}
\urlstyle{same}

% ---- Pictogramas (iguais ao template) ----
\newcommand{\up}{\textuparrow\,}
\newcommand{\down}{\textdownarrow\,}
\newcommand{\then}{$\rightsquigarrow\,$}
\newcommand{\so}{{$\Rightarrow\,$}}
